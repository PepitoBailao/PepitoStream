# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pepitostream
REDIS_URL=redis://localhost:6379

# TorBox API
TORBOX_API_KEY=your_torbox_api_key_here
TORBOX_API_ENDPOINT=https://api.torbox.app/v1

# Authentication
SECRET_AUTH_ENABLED=true
SECRET_AUTH_TTL=3600
SECRET_AUTH_RATE_LIMIT_WINDOW=900
SECRET_AUTH_MAX_REQUESTS_PER_IP=10

# Streaming
STREAM_TIMEOUT_MS=10000
STREAM_MAX_COPIES=3
STREAM_BLACKLIST_DURATION_MS=3600000

# Quality Profiles
PEPITO_CINEMA_QUALITY=4K
PEPITO_VOYAGE_QUALITY=480p
PEPITO_NORMAL_QUALITY=1080p
PEPITO_MACQUEEN_QUALITY=720p

# Language Preferences
DEFAULT_LANGUAGE=vf
PREFERRED_LANGUAGES=vf,vo,vostfr

# File Size Limits
MAX_FILE_SIZE_MB=2000

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
