# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pepito_stream
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=pepito_stream

# API Keys
TMDB_API_KEY=your_tmdb_api_key_here
TORBOX_API_KEY=your_torbox_api_key_here
JIKAN_API_URL=https://api.jikan.moe/v4

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d

# Server
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (Optional)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=pepito-stream

# Cloudflare Tunnel (Optional)
CLOUDFLARE_TUNNEL_URL=your_tunnel_url

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Analytics
SENTRY_DSN=your_sentry_dsn

# App
NEXT_PUBLIC_APP_NAME=PepitoStream
NEXT_PUBLIC_APP_URL=http://localhost:3000
