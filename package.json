{
  "name": "pepitostream",
  "version": "2.0.0",
  "description": "Advanced streaming platform with torrent indexing and adaptive quality selection",
  "main": "backend/src/server.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && nodemon --exec ts-node src/server.ts",
    "dev:frontend": "next dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && tsc",
    "build:frontend": "next build",
    "start": "node backend/dist/server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:init": "node scripts/initDb.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "scraper:run": "ts-node backend/src/workers/scraperWorker.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "streaming",
    "torrent",
    "indexing",
    "video",
    "anime",
    "movies",
    "series"
  ],
  "author": "PepitoBailao",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "typescript": "^5.3.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "torrent-stream": "^1.2.1",
    "webtorrent": "^1.9.0",
    "parseTorrent": "^9.1.0",
    "node-fetch": "^3.3.2",
    "zustand": "^4.4.0",
    "tailwindcss": "^3.3.0",
    "recharts": "^2.10.0",
    "react-table": "^8.10.0",
    "react-icons": "^4.12.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "compression": "^1.7.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "pino": "^8.17.0",
    "pino-pretty": "^10.2.3",
    "bull": "^4.11.4",
    "node-cache": "^5.1.2",
    "fuse.js": "^7.0.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0"
  }
}
